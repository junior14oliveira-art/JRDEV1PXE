*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Logs
logs/*.log

# Arquivos de boot gerados automaticamente (binários grandes, não versionar)
app/resources/boot/boot.wim
app/resources/boot/BCD
app/resources/boot/boot.sdi
app/resources/boot/boot.ipxe
app/resources/boot/autoexec.ipxe

# Pacotes de drivers corporativos (arquivos grandes — distribuir separadamente)
# Copie manualmente para app/resources/drivers/ antes de usar
app/resources/drivers/*.7z

# Executáveis compilados (gerados pelo BUILD_TUDO.bat — não versionar)
LicenseManager.exe
LicenseManager.spec
WinPE_Studio_Setup.exe
WinPE_Studio_Setup2.exe
*.iso
INJETAR_LOG.txt

# Specs gerados automaticamente pelo PyInstaller
license_manager/LicenseManager.spec

# Workspace de trabalho (pastas temporárias de extração de ISO)
WinPE_Studio_Workspace/
.vscode/
.idea/
*.suo
*.user

